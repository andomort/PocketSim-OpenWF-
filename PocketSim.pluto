local pending_actions = {}
local spawned_avatars = {}

local status_version = 0
local status_state = "ready"
local status_message = "PocketSim is starting."
local last_enemy_label = ""
local overlay_visible = true

local routes_registered = false
local commands_registered = false

local overlay_ids = {}
local overlay_box = nil
local overlay_title = nil
local overlay_url = nil
local overlay_status = nil
local overlay_count = nil
local overlay_hint = nil
local overlay_page_url = nil
local f8_was_down = false

local function is_null(value)
	if value == nil then
		return true
	end

	local ok, result = pcall(function()
		return IsNull(value)
	end)

	return ok and result
end

local function clamp_integer(value, minimum, maximum, fallback)
	value = tonumber(value)
	if value == nil then
		return fallback
	end

	value = math.floor(value)

	if value < minimum then
		return minimum
	end

	if value > maximum then
		return maximum
	end

	return value
end

local function clamp_number(value, minimum, maximum, fallback)
	value = tonumber(value)
	if value == nil then
		return fallback
	end

	if value < minimum then
		return minimum
	end

	if value > maximum then
		return maximum
	end

	return value
end

local function json_escape(value)
	value = tostring(value or "")
	value = value:gsub("\\", "\\\\")
	value = value:gsub('"', '\\"')
	value = value:gsub("\r", "\\r")
	value = value:gsub("\n", "\\n")
	value = value:gsub("\t", "\\t")
	return value
end

local function tracked_count()
	local count = 0

	for index = #spawned_avatars, 1, -1 do
		local avatar = spawned_avatars[index]

		if is_null(avatar) then
			table.remove(spawned_avatars, index)
		else
			count = count + 1
		end
	end

	return count
end

local function remove_overlay_elements()
	for _, id in ipairs(overlay_ids) do
		pcall(function()
			owf_overlay_remove(id)
		end)
	end

	overlay_ids = {}
	overlay_box = nil
	overlay_title = nil
	overlay_url = nil
	overlay_status = nil
	overlay_count = nil
	overlay_hint = nil

	pcall(owf_overlay_update)
end

local build_overlay

local function set_overlay_visibility(visible)
	overlay_visible = visible == true

	if overlay_visible then
		if #overlay_ids == 0 and overlay_page_url ~= nil then
			build_overlay(overlay_page_url)
		else
			for _, id in ipairs(overlay_ids) do
				pcall(function()
					owf_overlay_set_visibility(id, true)
				end)
			end

			pcall(owf_overlay_update)
		end
	else
		remove_overlay_elements()
	end
end

build_overlay = function(page_url)
	overlay_page_url = page_url

	if not overlay_visible then
		return
	end

	remove_overlay_elements()

	local function add_id(id)
		if id ~= nil then
			table.insert(overlay_ids, id)
		end
		return id
	end

	overlay_box = add_id(
		owf_overlay_add_rect(18, 18, 580, 78, 17, 14, 23)
	)

	overlay_title = add_id(
		owf_overlay_add_text(
			30, 25,
			"POCKETSIM",
			OWF_FONT_SIMPLE8,
			193, 173, 255,
			2
		)
	)

	overlay_hint = add_id(
		owf_overlay_add_text(
			508, 30,
			"F8: HIDE",
			OWF_FONT_SIMPLE8,
			170, 162, 180,
			1
		)
	)

	overlay_url = add_id(
		owf_overlay_add_text(
			30, 53,
			page_url,
			OWF_FONT_SIMPLE8,
			170, 162, 180,
			1
		)
	)

	overlay_status = add_id(
		owf_overlay_add_text(
			30, 75,
			"",
			OWF_FONT_SIMPLE8,
			119, 229, 160,
			1
		)
	)

	overlay_count = add_id(
		owf_overlay_add_text(
			472, 75,
			"Tracked: 0",
			OWF_FONT_SIMPLE8,
			170, 162, 180,
			1
		)
	)

	pcall(owf_overlay_update)
end

local function update_overlay()
	if overlay_status == nil then
		return
	end

	local text = status_message

	if #text > 37 then
		text = text:sub(1, 34) .. "..."
	end

	pcall(function()
		owf_overlay_set_text(overlay_status, text)
		owf_overlay_set_text(
			overlay_count,
			"Tracked: " .. tostring(tracked_count())
		)

		if status_state == "error" then
			owf_overlay_set_colour(
				overlay_status,
				245, 102, 120
			)
		elseif status_state == "busy" then
			owf_overlay_set_colour(
				overlay_status,
				255, 199, 102
			)
		else
			owf_overlay_set_colour(
				overlay_status,
				119, 229, 160
			)
		end

		owf_overlay_update()
	end)
end

local function publish_status()
	local content =
		'{"version":' .. tostring(status_version) ..
		',"state":"' .. json_escape(status_state) ..
		'","message":"' .. json_escape(status_message) ..
		'","trackedCount":' .. tostring(tracked_count()) ..
		',"lastEnemy":"' .. json_escape(last_enemy_label) ..
		'","overlayVisible":' .. tostring(overlay_visible) ..
		'}'

	pcall(function()
		owf_unregister_custom_route(STATUS_ROUTE)
	end)

	owf_register_custom_route(
		STATUS_ROUTE,
		"application/json; charset=utf-8",
		content
	)

	update_overlay()
end

local function set_status(state, message, send_to_chat)
	status_version = status_version + 1
	status_state = tostring(state or "ready")
	status_message = tostring(message or "")
	publish_status()
	print("[PocketSim] " .. status_message)

	if send_to_chat then
		chat_system_reply("[PocketSim] " .. status_message)
	end
end

local function url_decode(value)
	value = tostring(value or "")
	value = value:gsub("+", " ")
	value = value:gsub("%%(%x%x)", function(hex)
		return string.char(tonumber(hex, 16))
	end)
	return value
end

local function parse_query(raw)
	local text = tostring(raw or "")
	local question = text:find("?", 1, true)

	if question ~= nil then
		text = text:sub(question + 1)
	end

	local values = {}

	for part in text:gmatch("[^&]+") do
		local equals = part:find("=", 1, true)

		if equals ~= nil then
			local key = url_decode(part:sub(1, equals - 1))
			local value = url_decode(part:sub(equals + 1))
			values[key] = value
		end
	end

	return values
end

local function enqueue_action(kind, raw)
	table.insert(pending_actions, {
		kind = kind,
		raw = tostring(raw or ""),
	})

	set_status(
		"busy",
		kind == "spawn" and
			"Spawn request queued." or
			kind == "clear" and
			"Clear request queued." or
			"Overlay setting queued.",
		false
	)
end

local function clear_spawned()
	local removed = 0

	for index = #spawned_avatars, 1, -1 do
		local avatar = spawned_avatars[index]

		if not is_null(avatar) then
			pcall(function()
				avatar:Destroy()
			end)
			removed = removed + 1
		end

		table.remove(spawned_avatars, index)
	end

	return removed
end

local function load_resource(path)
	local ok, loader = pcall(function()
		return UISys.ScriptResLoader_Create({ path })
	end)

	if not ok or is_null(loader) then
		return false, ok and
			"Resource loader returned null." or
			tostring(loader)
	end

	local started = os.millis()

	while not loader:IsDone() do
		if owf_get_stop_requested() then
			loader:Abort()
			return false, "Script stop requested."
		end

		if os.millis() - started > RESOURCE_LOAD_TIMEOUT_MS then
			loader:Abort()
			return false, "Resource loading timed out."
		end

		yield()
	end

	return true, nil
end

local function get_spawn_origin(mode, player)
	local camera = gRegion:GetGameCamera()
	local camera_position = camera:GetPosition()
	local camera_direction = AngleToDirection(camera:GetRotation())

	if mode == 1 then
		local hit_position = Vector()
		local ray_end = camera_position + camera_direction * 500

		local ray_ok, hit = pcall(function()
			return gRegion:Raycast(
				camera_position,
				ray_end,
				player,
				nil,
				hit_position
			)
		end)

		if ray_ok and hit then
			return hit_position + Vector(0, 0.5, 0)
		end

		return player:GetPosition() + camera_direction * 8
	elseif mode == 2 then
		return player:GetPosition() + camera_direction * 8
	end

	return player:GetPosition() + Vector(0, 0.5, 0)
end

local function get_grid_offset(index, count, spacing)
	if count <= 1 then
		return ZERO_VECTOR
	end

	local side = math.ceil(math.sqrt(count))
	local zero_index = index - 1
	local row = math.floor(zero_index / side)
	local column = zero_index % side
	local center = (side - 1) / 2

	return Vector(
		(column - center) * spacing,
		0,
		(row - center) * spacing
	)
end

local function spawn_request(params)
	local path = tostring(params.path or "")
	local enemy_info = ALLOWED_ENEMIES[path]

	if enemy_info == nil then
		return 0, "The requested enemy path is not in the validated catalog."
	end

	local display_name = enemy_info.label
	local level = clamp_integer(params.level, 1, 9999, 100)
	local count = clamp_integer(params.count, 1, 20, 1)
	local mode = clamp_integer(params.mode, 1, 3, 1)
	local spacing = clamp_number(params.spacing, 0.5, 20, 2.5)
	local friendly = tostring(params.friendly or "0") == "1"
	local clear_first = tostring(params.clear or "0") == "1"

	last_enemy_label = display_name

	if clear_first then
		local removed = clear_spawned()

		set_status(
			"busy",
			"Cleared " .. tostring(removed) ..
			" tracked enemies. Loading " ..
			display_name .. "...",
			false
		)
	else
		set_status(
			"busy",
			"Loading " .. display_name .. "...",
			false
		)
	end

	local player = gRegion:GetLocalPlayerAvatar()

	if is_null(player) then
		return 0, "No local player avatar was found."
	end

	local npc_manager = gRegion:GetNpcMgr()

	if is_null(npc_manager) then
		return 0, "The current level has no NPC manager."
	end

	local loaded, load_error = load_resource(path)

	if not loaded then
		return 0, load_error
	end

	local type_ok, agent_type = pcall(function()
		return Type(path)
	end)

	if not type_ok or is_null(agent_type) then
		return 0, type_ok and
			"The selected enemy Type returned null." or
			tostring(agent_type)
	end

	local director_ok, director = pcall(function()
		return npc_manager:GetAiDirector()
	end)

	if director_ok and not is_null(director) then
		pcall(function()
			director:SetMaxPopulationSpawnCount(100)
			director:SetMaxAI(100)
		end)
	end

	local origin = get_spawn_origin(mode, player)
	local rotation = player:GetRotation()
	local player_faction = player:GetFaction()
	local created = 0

	for index = 1, count do
		local position =
			origin + get_grid_offset(index, count, spacing)

		local create_ok, agent = pcall(function()
			return npc_manager:CreateAgentAtPosition(
				agent_type,
				position,
				rotation,
				EMPTY_SYMBOL,
				level
			)
		end)

		if not create_ok or is_null(agent) then
			return created,
				"CreateAgentAtPosition failed after " ..
				tostring(created) .. " spawn(s): " ..
				(create_ok and "agent was null" or tostring(agent))
		end

		local avatar = nil

		for attempt = 1, 90 do
			local avatar_ok, result = pcall(function()
				return agent:GetAvatar()
			end)

			if avatar_ok then
				avatar = result
			end

			if not is_null(avatar) then
				break
			end

			yield()
		end

		if is_null(avatar) then
			return created,
				"An agent was created, but no avatar appeared within 90 frames."
		end

		if friendly then
			pcall(function()
				avatar:SetFaction(player_faction)
			end)
		end

		table.insert(spawned_avatars, avatar)
		created = created + 1
	end

	return created, nil
end

local function process_action(action)
	if action.kind == "clear" then
		local removed = clear_spawned()

		set_status(
			"ready",
			"Removed " .. tostring(removed) ..
			" enemies spawned by PocketSim.",
			true
		)

		return
	end

	if action.kind == "overlay" then
		local params = parse_query(action.raw)
		set_overlay_visibility(
			tostring(params.visible or "1") ~= "0"
		)

		set_status(
			"ready",
			overlay_visible and
				"In-game status overlay enabled." or
				"In-game status overlay hidden.",
			false
		)

		return
	end

	local params = parse_query(action.raw)
	local created, error_text = spawn_request(params)

	if created > 0 then
		set_status(
			error_text == nil and "ready" or "error",
			"Spawned " .. tostring(created) .. " x " ..
			last_enemy_label .. " at level " ..
			tostring(
				clamp_integer(params.level, 1, 9999, 100)
			) ..
			(error_text == nil and "." or ". " .. error_text),
			true
		)
	elseif error_text ~= nil then
		set_status("error", error_text, true)
	else
		set_status(
			"error",
			"The spawn request did not create an enemy.",
			true
		)
	end
end

local function register_interfaces()
	owf_register_custom_route(
		PAGE_ROUTE,
		"text/html; charset=utf-8",
		PAGE_HTML
	)

	owf_register_command(SPAWN_COMMAND, function(raw)
		enqueue_action("spawn", raw)
	end)

	owf_register_command(CLEAR_COMMAND, function(raw)
		enqueue_action("clear", raw)
	end)

	owf_register_command(OVERLAY_COMMAND, function(raw)
		enqueue_action("overlay", raw)
	end)

	routes_registered = true
	commands_registered = true
end

local function cleanup()
	if commands_registered then
		pcall(function()
			owf_unregister_command(SPAWN_COMMAND)
		end)

		pcall(function()
			owf_unregister_command(CLEAR_COMMAND)
		end)

		pcall(function()
			owf_unregister_command(OVERLAY_COMMAND)
		end)
	end

	if routes_registered then
		pcall(function()
			owf_unregister_custom_route(PAGE_ROUTE)
		end)

		pcall(function()
			owf_unregister_custom_route(STATUS_ROUTE)
		end)
	end

	remove_overlay_elements()
end

local register_ok, register_error = pcall(register_interfaces)

if not register_ok then
	cleanup()
	error(
		"PocketSim registration failed: " ..
		tostring(register_error)
	)
end

local port = owf_get_client_http_port()
local page_url =
	"http://localhost:" .. tostring(port) .. PAGE_ROUTE

build_overlay(page_url)

set_status(
	"ready",
	"Ready.",
	false
)

chat_system_reply("[PocketSim] Open " .. page_url)

while not owf_get_stop_requested() do
	local f8_is_down = owf_is_key_down(VK_F8)

	if f8_is_down and not f8_was_down then
		set_overlay_visibility(not overlay_visible)

		status_version = status_version + 1
		status_state = "ready"
		status_message =
			overlay_visible and
				"In-game PocketSim overlay shown." or
				"In-game PocketSim overlay hidden. Press F8 to show it."

		publish_status()
	end

	f8_was_down = f8_is_down

	if #pending_actions > 0 then
		local action = table.remove(pending_actions, 1)

		local ok, error_text = pcall(function()
			process_action(action)
		end)

		if not ok then
			set_status(
				"error",
				"Unhandled PocketSim error: " ..
				tostring(error_text),
				true
			)
		end
	end

	yield()
end

cleanup()
chat_system_reply("[PocketSim] Stopped.")