-- PocketSim v1
-- Browser interface handles selection and input.
-- Pluto handles resource loading, spawning, clearing, and status.
--
-- Contains 1111 enemy agent paths validated against the user's game build.
-- Includes player-facing faction corrections for mislabeled metadata variants.
--
-- Start with:
--   /script pocketsim
--
-- Then open the URL printed in chat, normally:
--   http://localhost:6155/pocketsim

local PAGE_ROUTE = "/pocketsim"
local STATUS_ROUTE = "/pocketsim-status.json"
local SPAWN_COMMAND = "pocketsim_spawn"
local CLEAR_COMMAND = "pocketsim_clear"
local OVERLAY_COMMAND = "pocketsim_overlay"
$define VK_F8 = 0x77

local RESOURCE_LOAD_TIMEOUT_MS = 30000

local PAGE_HTML = [=[<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Pocket Simulacrum</title>
<style>
:root {
    color-scheme: dark;
    --bg: #08070c;
    --panel: #111019;
    --panel2: #171520;
    --panel3: #211c2c;
    --border: #373142;
    --text: #f2eef7;
    --muted: #aaa3b2;
    --accent: #9d7bff;
    --accent2: #c1adff;
    --danger: #ff6b79;
    --success: #77e5a0;
    --warning: #ffc766;
}
* { box-sizing: border-box; }
html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; }
body {
    background: radial-gradient(circle at top, #191326 0, var(--bg) 45%);
    color: var(--text);
    font-family: Inter, Segoe UI, Arial, sans-serif;
}
button, input, select { font: inherit; }
button { cursor: pointer; }
.app {
    height: 100vh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
}
header {
    padding: 12px 15px 10px;
    border-bottom: 1px solid var(--border);
    background: rgba(8, 7, 12, .96);
}
.title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
}
h1 { margin: 0; font-size: 21px; font-weight: 700; }
.subtitle { color: var(--muted); font-size: 12px; }
.toolbar {
    display: grid;
    grid-template-columns: minmax(230px, 1fr) 190px auto;
    gap: 9px;
}
input, select, .plain-button {
    min-height: 38px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--panel2);
    color: var(--text);
}
input, select { padding: 8px 10px; }
.plain-button { padding: 8px 12px; }
.plain-button:hover { border-color: var(--accent); }
main {
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(420px, 1fr) 340px;
    gap: 11px;
    padding: 11px;
}
.browser, .settings {
    min-height: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(17, 16, 25, .97);
}
.browser {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
}
.tabs {
    display: flex;
    gap: 6px;
    padding: 9px;
    border-bottom: 1px solid var(--border);
}
.tab {
    border: 1px solid var(--border);
    background: var(--panel2);
    color: var(--muted);
    border-radius: 999px;
    padding: 6px 12px;
}
.tab.active {
    color: #120b20;
    background: var(--accent);
    border-color: var(--accent);
    font-weight: 700;
}
.results-header {
    padding: 9px 11px;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: 10px;
}
.enemy-list {
    min-height: 0;
    overflow-y: auto;
    padding: 6px;
}
.enemy {
    width: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 9px;
    align-items: center;
    text-align: left;
    padding: 9px 10px;
    margin-bottom: 5px;
    border-radius: 6px;
    border: 1px solid #2c2735;
    background: #15131d;
    color: var(--text);
}
.enemy:hover { border-color: #65577a; }
.enemy.selected {
    border-color: var(--accent);
    background: #211a34;
    box-shadow: inset 3px 0 0 var(--accent);
}
.favorite {
    width: 31px;
    height: 31px;
    border: 0;
    background: transparent;
    color: #746c7f;
    font-size: 19px;
    line-height: 1;
}
.favorite.on { color: var(--warning); }
.enemy-main { min-width: 0; }
.enemy-name {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.enemy-path {
    display: block;
    margin-top: 3px;
    color: #81798b;
    font-family: Consolas, monospace;
    font-size: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.enemy-faction {
    color: var(--muted);
    font-size: 11px;
}
.empty {
    padding: 20px;
    color: var(--muted);
}
.settings {
    overflow-y: auto;
    padding: 12px;
}
.selected-card {
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: #15131d;
    margin-bottom: 12px;
}
.selected-title-row {
    display: flex;
    gap: 8px;
    justify-content: space-between;
    align-items: flex-start;
}
.selected-card strong { display: block; margin-bottom: 5px; }
.selected-card code {
    display: block;
    color: var(--muted);
    font-size: 10px;
    word-break: break-all;
}
.small-button {
    min-height: 29px;
    padding: 4px 8px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--panel2);
    color: var(--text);
    white-space: nowrap;
}
.field { margin-bottom: 11px; }
.field label {
    display: block;
    color: var(--muted);
    margin-bottom: 5px;
    font-size: 12px;
}
.field input, .field select { width: 100%; }
.inline {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}
.quick-levels {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 5px;
    margin-top: 6px;
}
.quick-levels button {
    min-height: 28px;
    border-radius: 5px;
    border: 1px solid var(--border);
    background: var(--panel2);
    color: var(--muted);
}
.check {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 11px 0;
}
.check input { width: 17px; height: 17px; min-height: 0; }
.actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 13px;
}
.action {
    min-height: 42px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--panel2);
    color: var(--text);
}
.action.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #0d0818;
    font-weight: 750;
}
.action.danger {
    border-color: #713741;
    color: #ffc7ce;
}
.hint {
    margin-top: 11px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.45;
}
footer {
    min-height: 42px;
    padding: 9px 13px;
    border-top: 1px solid var(--border);
    background: rgba(8, 7, 12, .97);
    display: flex;
    align-items: center;
    gap: 9px;
}
.status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--muted);
    flex: 0 0 auto;
}
.status-dot.ready { background: var(--success); }
.status-dot.busy { background: var(--warning); }
.status-dot.error { background: var(--danger); }
#statusText {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#trackedCount {
    margin-left: auto;
    color: var(--muted);
    white-space: nowrap;
}
@media (max-width: 850px) {
    html, body { overflow: auto; }
    .app { min-height: 100vh; height: auto; }
    .toolbar { grid-template-columns: 1fr; }
    main { grid-template-columns: 1fr; }
    .browser { min-height: 62vh; }
    .settings { overflow: visible; }
}
</style>
</head>
<body>
<div class="app">
<header>
    <div class="title-row">
        <div>
            <h1>Pocket Simulacrum</h1>
            <div class="subtitle">andomort&#39;s pocket simulacrum</div>
        </div>
        <label class="check" style="margin:0">
            <input id="gameOverlay" type="checkbox" checked>
            Show in-game status
        </label>
    </div>
    <div class="toolbar">
        <input id="search" autocomplete="off" placeholder="Search enemy name or internal path">
        <select id="faction"></select>
        <button id="clearFilters" class="plain-button">Clear filters</button>
    </div>
</header>

<main>
    <section class="browser">
        <div class="tabs">
            <button class="tab active" data-view="all">All</button>
            <button class="tab" data-view="favorites">Favorites</button>
            <button class="tab" data-view="recent">Recent</button>
        </div>
        <div class="results-header">
            <span id="resultsText">Loading enemies…</span>
            <span id="viewHint">Double-click to spawn</span>
        </div>
        <div class="enemy-list" id="enemyList"></div>
    </section>

    <aside class="settings">
        <div class="selected-card">
            <div class="selected-title-row">
                <div>
                    <strong id="selectedName">No enemy selected</strong>
                    <code id="selectedPath">Choose an enemy from the list.</code>
                </div>
                <button id="copyPath" class="small-button">Copy path</button>
            </div>
        </div>

        <div class="inline">
            <div class="field">
                <label for="level">Enemy level</label>
                <input id="level" type="number" min="1" max="9999" value="100">
                <div class="quick-levels">
                    <button data-level="100">100</button>
                    <button data-level="500">500</button>
                    <button data-level="1000">1000</button>
                    <button data-level="9999">9999</button>
                </div>
            </div>
            <div class="field">
                <label for="count">Count</label>
                <input id="count" type="number" min="1" max="20" value="1">
            </div>
        </div>

        <div class="field">
            <label for="position">Spawn position</label>
            <select id="position">
                <option value="1">Crosshair</option>
                <option value="2">In front of player</option>
                <option value="3">At player position</option>
            </select>
        </div>

        <div class="field">
            <label for="spacing">Spacing between multiple enemies</label>
            <input id="spacing" type="number" min="0.5" max="20" step="0.5" value="2.5">
        </div>

        <label class="check">
            <input id="friendly" type="checkbox">
            Spawn as friendly
        </label>

        <label class="check">
            <input id="clearFirst" type="checkbox">
            Clear tracked enemies before spawning
        </label>

        <div class="actions">
            <button id="spawn" class="action primary">Spawn selected</button>
            <button id="clearSpawned" class="action danger">Clear tracked</button>
        </div>

        <div class="hint">
            Search updates immediately. Favorites, recent enemies, selected enemy,
            and spawn settings are stored in this browser. Press <b>Ctrl+K</b> to
            focus search and <b>Enter</b> to spawn the selected enemy.
        </div>
    </aside>
</main>

<footer>
    <span class="status-dot" id="statusDot"></span>
    <span id="statusText">Connecting to PocketSim…</span>
    <span id="trackedCount">Tracked: 0</span>
</footer>
</div>

<script>
const ENEMIES = [{"label":"Anarch Arcus [AnarchTauDaxArcherAgent]","name":"Anarch Arcus","faction":"Anarch","path":"/Lotus/Types/Enemies/Tau/Dax/TauDaxArcher/AnarchTauDaxArcherAgent"},{"label":"Anarch Arcus Lustratus","name":"Anarch Arcus Lustratus","faction":"Anarch","path":"/Lotus/Types/Enemies/Tau/Dax/TauDaxArcherLustratus/TauDaxArcherLustratusAgent"},{"label":"Anarch Capsarii [AnarchTauDaxMedicAgent]","name":"Anarch Capsarii","faction":"Anarch","path":"/Lotus/Types/Enemies/Tau/Dax/TauDaxMedic/AnarchTauDaxMedicAgent"},{"label":"Anarch Gladius [AnarchTauDaxSwordsmanAgent]","name":"Anarch Gladius","faction":"Anarch","path":"/Lotus/Types/Enemies/Tau/Dax/TauDaxSwordsman/AnarchTauDaxSwordsmanAgent"},{"label":"Anarch Gladius [AnarchTauDaxSwordsmanFemaleAgent]","name":"Anarch Gladius","faction":"Anarch","path":"/Lotus/Types/Enemies/Tau/Dax/TauDaxSwordsman/AnarchTauDaxSwordsmanFemaleAgent"},{"label":"Anarch Grineer Lancer","name":"Anarch Grineer Lancer","faction":"Anarch","path":"/Lotus/Types/Enemies/Tau/Grineer/TauGrineerLancer/AnarchTauGrineerLancerAgent"},{"label":"Anarch Grineer Trapper","name":"Anarch Grineer Trapper","faction":"Anarch","path":"/Lotus/Types/Enemies/Tau/Grineer/TauGrineerTrapper/AnarchTauGrineerTrapperAgent"},{"label":"Anarch Libritor [AnarchTauDaxHeavyArchgunAgent]","name":"Anarch Libritor","faction":"Anarch","path":"/Lotus/Types/Enemies/Tau/Dax/TauDaxHeavyArch/AnarchTauDaxHeavyArchgunAgent"},{"label":"Anarch Tenebra [AnarchTauDaxNinjaAgent]","name":"Anarch Tenebra","faction":"Anarch","path":"/Lotus/Types/Enemies/Tau/Dax/TauDaxNinja/AnarchTauDaxNinjaAgent"},{"label":"Dax Anarch Lustratus","name":"Dax Anarch Lustratus","faction":"Anarch","path":"/Lotus/Types/Enemies/Tau/Dax/TauDaxLustratus/AnarchTauDaxLustratusAgent"},{"label":"002-ER","name":"002-ER","faction":"Corpus","path":"/Lotus/Types/Enemies/CorpusChampions/TeamD/CCTeamDOspreyAgent"},{"label":"Alad V","name":"Alad V","faction":"Corpus","path":"/Lotus/Types/Enemies/Corpus/Vip/AladV/AladBossAgen