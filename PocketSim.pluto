RunnerWITWQuestAgent"},{"label":"Arbiters of Hexis Operative [HexisAllyAgentA]","name":"Arbiters of Hexis Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/HexisAllyAgentA"},{"label":"Arbiters of Hexis Operative [HexisAllyAgentB]","name":"Arbiters of Hexis Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/HexisAllyAgentB"},{"label":"Arbiters of Hexis Operative [HexisAllyAgentDefense]","name":"Arbiters of Hexis Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/HexisAllyAgentDefense"},{"label":"Ballas [BallasAgent]","name":"Ballas","faction":"Tenno","path":"/Lotus/Types/Enemies/Quests/Chimera/BallasAgent"},{"label":"Captive Virmink","name":"Captive Virmink","faction":"Tenno","path":"/Lotus/Types/Enemies/NokkoColony/Agents/NokkoLabCritterRescueTargetAgent"},{"label":"Cephalon Suda Operative [CephalonSudaAllyAgentA]","name":"Cephalon Suda Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/CephalonSudaAllyAgentA"},{"label":"Cephalon Suda Operative [CephalonSudaAllyAgentB]","name":"Cephalon Suda Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/CephalonSudaAllyAgentB"},{"label":"Erra [ErraSentientFollowerAgent]","name":"Erra","faction":"Tenno","path":"/Lotus/Types/Enemies/Sentients/Vip/Erra/ErraSentientFollowerAgent"},{"label":"K-Drive [CrpHoverboardDrifterSpawnAgent]","name":"K-Drive","faction":"Tenno","path":"/Lotus/Types/Enemies/Corpus/Venus/Hoverboard/TnwDrifterBoard/CrpHoverboardDrifterSpawnAgent"},{"label":"K-Drive [CrpHoverboardUnmannedSpawnAgent]","name":"K-Drive","faction":"Tenno","path":"/Lotus/Types/Enemies/Corpus/Venus/Hoverboard/CrpHoverboardUnmannedSpawnAgent"},{"label":"Lodun [FlyingDragonQuestAgent]","name":"Lodun","faction":"Duviri","path":"/Lotus/Types/Enemies/Duviri/Dragon/Flying/FlyingDragonQuestAgent"},{"label":"Lyon Allard","name":"Lyon Allard","faction":"Tenno","path":"/Lotus/Types/Enemies/Tau/Uriel/BossFightAllies/LyonBossFightAlly"},{"label":"Marie Leroux","name":"Marie Leroux","faction":"Tenno","path":"/Lotus/Types/Enemies/Tau/Uriel/BossFightAllies/MarieBossFightAlly"},{"label":"New Loka Operative [NewLokaAllyAgentA]","name":"New Loka Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/NewLokaAllyAgentA"},{"label":"New Loka Operative [NewLokaAllyAgentB]","name":"New Loka Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/NewLokaAllyAgentB"},{"label":"Ostron Boy","name":"Ostron Boy","faction":"Tenno","path":"/Lotus/Types/Enemies/Narmer/OstronScavengerBoyAgent"},{"label":"Perrin Sequence Operative [PerrinAgentA]","name":"Perrin Sequence Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/PerrinAgentA"},{"label":"Perrin Sequence Operative [PerrinAgentB]","name":"Perrin Sequence Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/PerrinAgentB"},{"label":"Red Veil Operative [RedVeilAllyAgentA]","name":"Red Veil Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/RedVeilAllyAgentA"},{"label":"Red Veil Operative [RedVeilAllyAgentB]","name":"Red Veil Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/RedVeilAllyAgentB"},{"label":"Red Veil Operative [RedVeilAllyAgentC]","name":"Red Veil Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/RedVeilAllyAgentC"},{"label":"Shockwave Moa [ShockwaveBipedHackedAgent]","name":"Shockwave Moa","faction":"Tenno","path":"/Lotus/Types/Enemies/Corpus/BipedRobot/AIWeek/ShockwaveBipedHackedAgent"},{"label":"Stalker [StalkerSpecterAgent]","name":"Stalker","faction":"Stalker","path":"/Lotus/Types/Enemies/Stalker/StalkerSpecterAgent"},{"label":"Steel Meridian Operative [SteelMeridianAllyAgentA]","name":"Steel Meridian Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/SteelMeridianAllyAgentA"},{"label":"Steel Meridian Operative [SteelMeridianAllyAgentB]","name":"Steel Meridian Operative","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/SyndicateAllies/SteelMeridianAllyAgentB"},{"label":"Tenno Specter [TennoReplicantAllyAgent]","name":"Tenno Specter","faction":"Tenno","path":"/Lotus/Types/Enemies/TennoReplicants/TennoReplicantAllyAgent"},{"label":"Teshin [TeshinStarWarsAgent]","name":"Teshin","faction":"Tenno","path":"/Lotus/Types/Enemies/Grineer/Vip/Teshin/TeshinStarWarsAgent"},{"label":"Teshin [TeshinWarWithinAgent]","name":"Teshin","faction":"Tenno","path":"/Lotus/Types/Enemies/Grineer/Vip/Teshin/TeshinWarWithinAgent"},{"label":"Teshin Specter","name":"Teshin Specter","faction":"Tenno","path":"/Lotus/Types/Enemies/Grineer/Vip/Teshin/TeshinShadowAgent"}];
const BY_PATH = new Map(ENEMIES.map(enemy => [enemy.path, enemy]));

const STORAGE = {
    favorites: "pocketsim.v1.favorites",
    recents: "pocketsim.v1.recents",
    selected: "pocketsim.v1.selected",
    settings: "pocketsim.v1.settings",
    view: "pocketsim.v1.view",
};

const ui = {
    search: document.getElementById("search"),
    faction: document.getElementById("faction"),
    clearFilters: document.getElementById("clearFilters"),
    enemyList: document.getElementById("enemyList"),
    resultsText: document.getElementById("resultsText"),
    selectedName: document.getElementById("selectedName"),
    selectedPath: document.getElementById("selectedPath"),
    copyPath: document.getElementById("copyPath"),
    level: document.getElementById("level"),
    count: document.getElementById("count"),
    position: document.getElementById("position"),
    spacing: document.getElementById("spacing"),
    friendly: document.getElementById("friendly"),
    clearFirst: document.getElementById("clearFirst"),
    gameOverlay: document.getElementById("gameOverlay"),
    spawn: document.getElementById("spawn"),
    clearSpawned: document.getElementById("clearSpawned"),
    statusDot: document.getElementById("statusDot"),
    statusText: document.getElementById("statusText"),
    trackedCount: document.getElementById("trackedCount"),
    tabs: [...document.querySelectorAll(".tab")],
};

function readJson(key, fallback) {
    try {
        const value = JSON.parse(localStorage.getItem(key));
        return value ?? fallback;
    } catch {
        return fallback;
    }
}

function writeJson(key, value) {
    localStorage.setItem(key, JSON.stringify(value));
}

let favorites = new Set(readJson(STORAGE.favorites, []));
let recents = readJson(STORAGE.recents, []).filter(path => BY_PATH.has(path)).slice(0, 30);
let currentView = localStorage.getItem(STORAGE.view) || "all";
let selectedEnemy = BY_PATH.get(localStorage.getItem(STORAGE.selected)) || null;
let lastStatusVersion = -1;

const savedSettings = readJson(STORAGE.settings, {});
ui.level.value = savedSettings.level ?? 100;
ui.count.value = savedSettings.count ?? 1;
ui.position.value = String(savedSettings.position ?? 1);
ui.spacing.value = savedSettings.spacing ?? 2.5;
ui.friendly.checked = Boolean(savedSettings.friendly);
ui.clearFirst.checked = Boolean(savedSettings.clearFirst);
ui.gameOverlay.checked = savedSettings.gameOverlay !== false;

const factionCounts = new Map();
for (const enemy of ENEMIES) {
    factionCounts.set(enemy.faction, (factionCounts.get(enemy.faction) || 0) + 1);
}
const factions = [...factionCounts.keys()].sort((a, b) => a.localeCompare(b));
ui.faction.innerHTML =
    '<option value="">All factions</option>' +
    factions.map(faction =>
        `<option value="${escapeHtml(faction)}">${escapeHtml(faction)} (${factionCounts.get(faction)})</option>`
    ).join("");

function escapeHtml(value) {
    return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}

function persistSettings() {
    writeJson(STORAGE.settings, {
        level: ui.level.value,
        count: ui.count.value,
        position: Number(ui.position.value),
        spacing: ui.spacing.value,
        friendly: ui.friendly.checked,
        clearFirst: ui.clearFirst.checked,
        gameOverlay: ui.gameOverlay.checked,
    });
}

function setView(view) {
    currentView = view;
    localStorage.setItem(STORAGE.view, view);
    for (const tab of ui.tabs) {
        tab.classList.toggle("active", tab.dataset.view === view);
    }
    renderEnemies();
}

function baseEnemiesForView() {
    if (currentView === "favorites") {
        return [...favorites].map(path => BY_PATH.get(path)).filter(Boolean);
    }
    if (currentView === "recent") {
        return recents.map(path => BY_PATH.get(path)).filter(Boolean);
    }
    return ENEMIES;
}

function filteredEnemies() {
    const query = ui.search.value.trim().toLowerCase();
    const faction = ui.faction.value;

    return baseEnemiesForView().filter(enemy => {
        const factionMatches = !faction || enemy.faction === faction;
        const searchMatches =
            !query ||
            enemy.label.toLowerCase().includes(query) ||
            enemy.path.toLowerCase().includes(query);

        return factionMatches && searchMatches;
    });
}

function setSelected(enemy) {
    selectedEnemy = enemy || null;

    if (selectedEnemy) {
        ui.selectedName.textContent = selectedEnemy.label;
        ui.selectedPath.textContent = selectedEnemy.path;
        localStorage.setItem(STORAGE.selected, selectedEnemy.path);
    } else {
        ui.selectedName.textContent = "No enemy selected";
        ui.selectedPath.textContent = "Choose an enemy from the list.";
        localStorage.removeItem(STORAGE.selected);
    }

    renderEnemies();
}

function toggleFavorite(path) {
    if (favorites.has(path)) favorites.delete(path);
    else favorites.add(path);

    writeJson(STORAGE.favorites, [...favorites]);
    renderEnemies();
}

function addRecent(path) {
    recents = [path, ...recents.filter(existing => existing !== path)].slice(0, 30);
    writeJson(STORAGE.recents, recents);
}

function renderEnemies() {
    const matches = filteredEnemies();
    ui.resultsText.textContent =
        `${matches.length.toLocaleString()} matching enemies`;

    const fragment = document.createDocumentFragment();

    for (const enemy of matches) {
        const row = document.createElement("button");
        row.className =
            "enemy" + (selectedEnemy?.path === enemy.path ? " selected" : "");

        const star = document.createElement("button");
        star.className = "favorite" + (favorites.has(enemy.path) ? " on" : "");
        star.type = "button";
        star.textContent = favorites.has(enemy.path) ? "★" : "☆";
        star.title = favorites.has(enemy.path) ? "Remove favorite" : "Add favorite";
        star.addEventListener("click", event => {
            event.stopPropagation();
            toggleFavorite(enemy.path);
        });

        const main = document.createElement("span");
        main.className = "enemy-main";
        main.innerHTML =
            `<span class="enemy-name">${escapeHtml(enemy.label)}</span>` +
            `<span class="enemy-path">${escapeHtml(enemy.path)}</span>`;

        const faction = document.createElement("span");
        faction.className = "enemy-faction";
        faction.textContent = enemy.faction;

        row.append(star, main, faction);
        row.addEventListener("click", () => setSelected(enemy));
        row.addEventListener("dblclick", () => {
            setSelected(enemy);
            spawnSelected();
        });

        fragment.appendChild(row);
    }

    ui.enemyList.replaceChildren(fragment);

    if (matches.length === 0) {
        ui.enemyList.innerHTML =
            '<div class="empty">No enemies match the current view and filters.</div>';
    }
}

function clampNumber(input, min, max, fallback) {
    let value = Number(input.value);
    if (!Number.isFinite(value)) value = fallback;
    value = Math.max(min, Math.min(max, value));
    input.value = String(value);
    return value;
}

async function runCommand(name, params = {}) {
    const query = new URLSearchParams(params).toString();
    const response = await fetch(`/${name}${query ? "?" + query : ""}`, {
        method: "GET",
        cache: "no-store",
    });

    if (!response.ok) {
        throw new Error(`${name} returned HTTP ${response.status}`);
    }

    return response.text();
}

async function spawnSelected() {
    if (!selectedEnemy) {
        ui.statusDot.className = "status-dot error";
        ui.statusText.textContent = "Select an enemy first.";
        return;
    }

    const level = Math.round(clampNumber(ui.level, 1, 9999, 100));
    const count = Math.round(clampNumber(ui.count, 1, 20, 1));
    const spacing = clampNumber(ui.spacing, 0.5, 20, 2.5);
    persistSettings();
    addRecent(selectedEnemy.path);

    ui.statusDot.className = "status-dot busy";
    ui.statusText.textContent = "Sending spawn request…";

    try {
        await runCommand("pocketsim_spawn", {
            path: selectedEnemy.path,
            level,
            count,
            mode: ui.position.value,
            spacing,
            friendly: ui.friendly.checked ? "1" : "0",
            clear: ui.clearFirst.checked ? "1" : "0",
        });
    } catch (error) {
        ui.statusDot.className = "status-dot error";
        ui.statusText.textContent = String(error);
    }
}

for (const tab of ui.tabs) {
    tab.addEventListener("click", () => setView(tab.dataset.view));
}

ui.search.addEventListener("input", renderEnemies);
ui.faction.addEventListener("change", renderEnemies);

ui.clearFilters.addEventListener("click", () => {
    ui.search.value = "";
    ui.faction.value = "";
    renderEnemies();
    ui.search.focus();
});

ui.copyPath.addEventListener("click", async () => {
    if (!selectedEnemy) return;
    try {
        await navigator.clipboard.writeText(selectedEnemy.path);
        ui.statusText.textContent = "Enemy path copied.";
    } catch {
        ui.statusText.textContent = selectedEnemy.path;
    }
});

for (const button of document.querySelectorAll("[data-level]")) {
    button.addEventListener("click", () => {
        ui.level.value = button.dataset.level;
        persistSettings();
    });
}

for (const element of [
    ui.level, ui.count, ui.position, ui.spacing,
    ui.friendly, ui.clearFirst
]) {
    element.addEventListener("change", persistSettings);
}

ui.gameOverlay.addEventListener("change", async () => {
    persistSettings();
    try {
        await runCommand("pocketsim_overlay", {
            visible: ui.gameOverlay.checked ? "1" : "0",
        });
    } catch (error) {
        ui.statusText.textContent = String(error);
    }
});

ui.spawn.addEventListener("click", spawnSelected);

ui.clearSpawned.addEventListener("click", async () => {
    ui.statusDot.className = "status-dot busy";
    ui.statusText.textContent = "Sending clear request…";
    try {
        await runCommand("pocketsim_clear");
    } catch (error) {
        ui.statusDot.className = "status-dot error";
        ui.statusText.textContent = String(error);
    }
});

document.addEventListener("keydown", event => {
    if (event.ctrlKey && event.key.toLowerCase() === "k") {
        event.preventDefault();
        ui.search.focus();
        ui.search.select();
        return;
    }

    if (event.key === "Enter" && document.activeElement !== ui.search) {
        event.preventDefault();
        spawnSelected();
    }
});

async function pollStatus() {
    try {
        const response = await fetch("/pocketsim-status.json", {
            cache: "no-store",
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        const status = await response.json();

        if (status.version !== lastStatusVersion) {
            lastStatusVersion = status.version;
            ui.statusText.textContent = status.message || "Ready.";
            ui.statusDot.className =
                "status-dot " + (status.state || "ready");
            ui.trackedCount.textContent =
                `Tracked: ${status.trackedCount ?? 0}`;

            if (typeof status.overlayVisible === "boolean") {
                ui.gameOverlay.checked = status.overlayVisible;
            }
        }
    } catch {
        ui.statusDot.className = "status-dot error";
        ui.statusText.textContent =
            "PocketSim script is not responding. Keep the script running.";
    }
}

setView(["all", "favorites", "recent"].includes(currentView) ? currentView : "all");

if (!selectedEnemy) {
    const first = filteredEnemies()[0];
    if (first) setSelected(first);
} else {
    setSelected(selectedEnemy);
}

ui.search.focus();
pollStatus();
setInterval(pollStatus, 400);
</script>
</body>
</html>]=]

