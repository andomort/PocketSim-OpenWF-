ntientOrtholystAgent]","name":"Ortholyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/Ortholyst/SentientOrtholystAgent"},{"label":"Ortholyst [SentientOrtholystTauAgent]","name":"Ortholyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/Ortholyst/SentientOrtholystTauAgent"},{"label":"Ortholyst [SunkillerOrtholystAgent]","name":"Ortholyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/Ortholyst/SunkillerOrtholystAgent"},{"label":"Stratal Dactolyst","name":"Stratal Dactolyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Tau/GuiltSentient/GroundPhase/DactolystGroundBossHardModeAgent"},{"label":"Summulyst","name":"Summulyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/Dolicholyst/SentientDolicholystAgent"},{"label":"Symbilyst [DrifterSymbilystAgent]","name":"Symbilyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/NewWar/DrifterSymbilystAgent"},{"label":"Symbilyst [EidolonSymbilystAgent]","name":"Symbilyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/Symbilyst/EidolonSymbilystAgent"},{"label":"Symbilyst [SentientSymbilystAgent]","name":"Symbilyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/Symbilyst/SentientSymbilystAgent"},{"label":"Symbilyst [SunkillerSymbilystAgent]","name":"Symbilyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/Symbilyst/SunkillerSymbilystAgent"},{"label":"Symbilyst [VenusSentientSymbilystAgent]","name":"Symbilyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/Venus/VenusSentientSymbilystAgent"},{"label":"Typholyst [SentientClotholystAgent]","name":"Typholyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/Clotholyst/SentientClotholystAgent"},{"label":"Typholyst [SentientClotholystTauAgent]","name":"Typholyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/Clotholyst/SentientClotholystTauAgent"},{"label":"Tyro Battalyst [DrifterSentientTrooperNoPowersAgent]","name":"Tyro Battalyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/NewWar/DrifterSentientTrooperNoPowersAgent"},{"label":"Tyro Battalyst [SentientTrooperNoPowersAgent]","name":"Tyro Battalyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/Troopers/SentientTrooperNoPowersAgent"},{"label":"Tyro Battalyst [VenusSentientTrooperNoPowersAgent]","name":"Tyro Battalyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/Venus/VenusSentientTrooperNoPowersAgent"},{"label":"Tyro Conculyst [DrifterSentientMeleeTrooperNoPowersAgent]","name":"Tyro Conculyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/NewWar/DrifterSentientMeleeTrooperNoPowersAgent"},{"label":"Tyro Conculyst [SentientMeleeTrooperNoPowersAgent]","name":"Tyro Conculyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/Troopers/SentientMeleeTrooperNoPowersAgent"},{"label":"Veyor Dactolyst","name":"Veyor Dactolyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Tau/GuiltSentient/SentientGuiltBossHardModeAgent"},{"label":"Vomvalyst","name":"Vomvalyst","faction":"Sentient","path":"/Lotus/Types/Enemies/Sentients/SentientFragmentVomvalystAgent"},{"label":"Nauseous Void Shade","name":"Nauseous Void Shade","faction":"Stalker","path":"/Lotus/Types/Enemies/Acolytes/GraspingCrawlerMinion"},{"label":"Protector Stalker","name":"Protector Stalker","faction":"Stalker","path":"/Lotus/Types/Enemies/Stalker/JadeStalkerAgent"},{"label":"Stalker [StalkerAgent]","name":"Stalker","faction":"Stalker","path":"/Lotus/Types/Enemies/Stalker/StalkerAgent"},{"label":"Void Shade","name":"Void Shade","faction":"Stalker","path":"/Lotus/Types/Enemies/Acolytes/CrawlerMinion"},{"label":"Packlet","name":"Packlet","faction":"Techrot","path":"/Lotus/Types/Enemies/InfestedLich/Packet/LichHairAgent"},{"label":"Techrot Babau [DeviationInfestedBabau1999Agent]","name":"Techrot Babau","faction":"Techrot","path":"/Lotus/Types/Enemies/WF1999Infested/InfestedBabau/DeviationInfestedBabau1999Agent"},{"label":"Techrot Baba