las","faction":"Corpus","path":"/Lotus/Types/Enemies/Corpus/Vip/Ambulas/BossAmbulasRangedAgent"},{"label":"Anti Moa","name":"Anti Moa","faction":"Corpus","path":"/Lotus/Types/Enemies/Corpus/BipedRobot/AIWeek/LaserDiscBipedAgent"},{"label":"Armaments Director","name":"Armaments Director","faction":"Corpus","path":"/Lotus/Types/Enemies/Corpus/Venus/Commanders/VenusCommanderAquaAgent"},{"label":"Armis Ulta","name":"Armis Ulta","faction":"Corpus","path":"/Lotus/Types/Enemies/CorpusChampions/TeamD/CCTeamDBusterAAgent"},{"label":"Attack Drone [DroneAttackAgent]","name":"Attack Drone","faction":"Corpus","path":"/Lotus/Types/Enemies/Corpus/Drones/DroneAttackAgent"},{"label":"Attack Drone [NokkoDroneBaseAgent]","name":"Attack Drone","faction":"Corpus","path":"/Lotus/Types/Enemies/NokkoColony/Agents/NokkoDroneBaseAgent"},{"label":"Attack Drone [VenusDroneBaseAgent]","name":"Attack Drone","faction":"Corpus","path":"/Lotus/Types/Enemies/Corpus/Venus/VenusDroneBaseAgent"},{"label":"Auditor","name":"Auditor","faction":"Corpus","path":"/Lotus/Types/Enemies/CorpusChampions/TeamB/CCTeamBRiotMoaAgent"},{"label":"Aurax Actinic","name":"Aurax Actinic","faction":"Corpus","path":"/Lotus/Types/Enemies/Corpus/Railjack/CrpSpecOpsShockerAgent"},{"label":"Aurax Atloc Raknoid","name":"Aurax Atloc Raknoid","faction":"Corpus","path":"/Lotus/Types/Enemies/Corpus/Railjack/SpecOpsArachnoidAgent"},{"label":"Aurax Baculus","name":"Aurax Baculus","faction":"Corpus","path":"/Lotus/Types/Enemies/Corpus/Railjack/SpecOpsStaffAgent"},{"label":"Aurax Culveri Moa","name":"Aurax Culveri Moa","faction":"Corpus","path":"/Lotus/Types/Enemies/Corpus/Railjack/SpecOpsFireMoaAgent"},{"label":"Aurax Polaris Moa","name":"Aurax Polaris Moa","faction":"Corpus","path":"/Lotus/Types/Enemies/Corpus/Railjack/SpecOpsIceMoaAgent"},{"label":"Aurax Vertec","name":"Aurax Vertec","faction":"Corpus","path":"/Lotus/Types/Enemies/Corpus/Railjack/CrpSpecOpsMinigunAgent"},{"label":"Axio Crewman","name":"Axio Crewman","faction":"Corpus